---
// 簡繁切換按鈕 — 使用 OpenCC 做前端實時轉換
// 預設為繁體（與文章原始語言一致），切換偏好存 localStorage
---
<button
  id="lang-toggle"
  aria-label="簡繁切換"
  title="簡繁切換"
  class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90 flex items-center justify-center"
>
  <span id="lang-toggle-label" class="text-sm font-bold">繁</span>
</button>

<script is:inline>
(function () {
  var STORAGE_KEY = "blog-lang-pref"; // 'tw' | 'cn'
  var LIB_URL = "/lib/opencc-full.js";
  var label = document.getElementById("lang-toggle-label");
  var btn = document.getElementById("lang-toggle");

  var SKIP_TAGS = { SCRIPT: 1, STYLE: 1, PRE: 1, CODE: 1, TEXTAREA: 1 };

  function shouldSkip(node) {
    var el = node.parentElement;
    while (el) {
      if (SKIP_TAGS[el.tagName]) return true;
      el = el.parentElement;
    }
    return false;
  }

  function collectTextNodes(root) {
    var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null);
    var nodes = [];
    var node;
    var cjk = /[\u3400-\u4DBF\u4E00-\u9FFF\uF900-\uFAFF]/;
    while ((node = walker.nextNode())) {
      if (!shouldSkip(node) && cjk.test(node.nodeValue)) {
        nodes.push(node);
      }
    }
    return nodes;
  }

  var converterCn = null; // tw -> cn
  function getConverterCn() {
    if (!converterCn) {
      converterCn = window.OpenCC.Converter({ from: "tw", to: "cn" });
    }
    return converterCn;
  }

  function applyLang(lang) {
    var nodes = collectTextNodes(document.body);
    for (var i = 0; i < nodes.length; i++) {
      if (nodes[i]._origTw === undefined) nodes[i]._origTw = nodes[i].nodeValue;
      nodes[i].nodeValue =
        lang === "cn" ? getConverterCn().convert(nodes[i]._origTw) : nodes[i]._origTw;
    }
    document.documentElement.lang = lang === "cn" ? "zh-CN" : "zh-TW";
    if (label) label.textContent = lang === "cn" ? "简" : "繁";
    try {
      localStorage.setItem(STORAGE_KEY, lang);
    } catch (e) {}
  }

  function currentPref() {
    try {
      return localStorage.getItem(STORAGE_KEY) || "tw";
    } catch (e) {
      return "tw";
    }
  }

  // 動態載入 OpenCC，載入完成後才啟用按鈕
  function loadOpenCC(cb) {
    if (window.OpenCC) {
      cb();
      return;
    }
    var s = document.createElement("script");
    s.src = LIB_URL;
    s.onload = cb;
    s.onerror = function () {
      if (label) label.textContent = "!";
      if (btn) btn.title = "轉換庫載入失敗";
    };
    document.head.appendChild(s);
  }

  function init() {
    loadOpenCC(function () {
      // 套用已存偏好
      var pref = currentPref();
      if (pref === "cn") applyLang("cn");

      if (btn) {
        btn.addEventListener("click", function () {
          var next = currentPref() === "tw" ? "cn" : "tw";
          applyLang(next);
        });
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>
