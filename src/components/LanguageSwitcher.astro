---
// 语言切换器 - 支持 en, zh_CN, zh_TW, ko
const languages = [
  { code: 'en', label: 'English', path: '/' },
  { code: 'zh_CN', label: '简体中文', path: '/zh-cn/' },
  { code: 'zh_TW', label: '繁體中文', path: '/zh-tw/' },
  { code: 'ko', label: '한국어', path: '/ko/' },
];
const currentPath = Astro.url.pathname;
// 判断当前语言
let currentLang = 'en';
if (currentPath.startsWith('/zh-cn/')) currentLang = 'zh_CN';
else if (currentPath.startsWith('/zh-tw/')) currentLang = 'zh_TW';
else if (currentPath.startsWith('/ko/')) currentLang = 'ko';
---
<div class="relative" id="lang-switcher">
  <button id="lang-btn" class="flex items-center gap-1 px-3 py-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 transition">
    <span class="text-sm">{languages.find(l => l.code === currentLang)?.label}</span>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
  </button>
  <div id="lang-menu" class="hidden absolute right-0 mt-2 w-32 bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-black/10 dark:border-white/10 py-1 z-50">
    {languages.map((lang) => (
      <a href={lang.path} class={`block px-4 py-2 text-sm hover:bg-black/5 dark:hover:bg-white/10 transition ${lang.code === currentLang ? 'text-[var(--primary)] font-medium' : ''}`}>
        {lang.label}
      </a>
    ))}
  </div>
</div>
<script>
  const btn = document.getElementById('lang-btn');
  const menu = document.getElementById('lang-menu');
  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    menu?.classList.toggle('hidden');
  });
  document.addEventListener('click', () => {
    menu?.classList.add('hidden');
  });
</script>
